<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚓  Turnos"
            android:textColor="@color/texto_claro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actualizar"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="@drawable/kpi_fondo"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/texto_claro"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/conectar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="🔐  Toca aquí para conectar los widgets con tu cuenta de administrador"
        android:textColor="@color/texto_claro"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bloque_hoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cab_hoy"
                style="@style/WidgetCabecera"
                android:text="HOY" />

            <TextView android:id="@+id/hoy_vacio" style="@style/WidgetVacio" android:text="Sin turnos" />
            <TextView android:id="@+id/hoy1" style="@style/WidgetFila" />
            <TextView android:id="@+id/hoy2" style="@style/WidgetFila" />
            <TextView android:id="@+id/hoy3" style="@style/WidgetFila" />
            <TextView android:id="@+id/hoy4" style="@style/WidgetFila" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bloque_man"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cab_man"
                style="@style/WidgetCabecera"
                android:text="MAÑANA" />

            <TextView android:id="@+id/man_vacio" style="@style/WidgetVacio" android:text="Sin turnos" />
            <TextView android:id="@+id/man1" style="@style/WidgetFila" />
            <TextView android:id="@+id/man2" style="@style/WidgetFila" />
            <TextView android:id="@+id/man3" style="@style/WidgetFila" />
            <TextView android:id="@+id/man4" style="@style/WidgetFila" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/texto_suave"
        android:textSize="10sp" />
</LinearLayout>

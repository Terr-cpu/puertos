<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡  Por resolver · 2 semanas"
            android:textColor="@color/texto_claro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actualizar"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="@drawable/kpi_fondo"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/texto_claro"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/conectar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="🔐  Toca aquí para conectar los widgets con tu cuenta de administrador"
        android:textColor="@color/texto_claro"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/k_necesitan" style="@style/WidgetKpi" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/n_necesitan" style="@style/WidgetNumero" android:text="–" />
            <TextView style="@style/WidgetEtiqueta" android:text="necesitan voluntarios" />
        </LinearLayout>

        <LinearLayout android:id="@+id/k_aceptar" style="@style/WidgetKpi" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/n_aceptar" style="@style/WidgetNumero" android:text="–" />
            <TextView style="@style/WidgetEtiqueta" android:text="apuntes por aceptar" />
        </LinearLayout>

        <LinearLayout android:id="@+id/k_bajas" style="@style/WidgetKpi" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/n_bajas" style="@style/WidgetNumero" android:text="–" />
            <TextView style="@style/WidgetEtiqueta" android:text="bajas sin cubrir" />
        </LinearLayout>

        <LinearLayout android:id="@+id/k_llave" style="@style/WidgetKpi">
            <TextView android:id="@+id/n_llave" style="@style/WidgetNumero" android:text="–" />
            <TextView style="@style/WidgetEtiqueta" android:text="sin llave" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="@color/texto_suave"
        android:textSize="10sp" />
</LinearLayout>

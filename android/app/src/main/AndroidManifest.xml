<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- La comprobación periódica solo se lanza con conexión (Android lo exige para esa condición) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Para que la comprobación de bajas y apuntes siga tras reiniciar el móvil -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Tema"
        android:supportsRtl="false"
        android:allowBackup="false">

        <!-- El planificador de siempre (asispuerto.org) dentro de la app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Conectar los widgets con la cuenta de administrador -->
        <activity
            android:name=".ConectarActivity"
            android:exported="false"
            android:label="@string/conectar_titulo"
            android:windowSoftInputMode="adjustResize" />

        <!-- Widget "Hoy y mañana" -->
        <receiver
            android:name=".WidgetTurnos"
            android:exported="true"
            android:label="@string/widget_turnos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_turnos_info" />
        </receiver>

        <!-- Widget "Por resolver" -->
        <receiver
            android:name=".WidgetResolver"
            android:exported="true"
            android:label="@string/widget_resolver">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_resolver_info" />
        </receiver>
        <!-- Widget "Próximos 7 días" -->
        <receiver
            android:name=".WidgetSemana"
            android:exported="true"
            android:label="@string/widget_semana">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semana_info" />
        </receiver>

        <!-- Widget "Bandeja de pendientes" -->
        <receiver
            android:name=".WidgetBandeja"
            android:exported="true"
            android:label="@string/widget_bandeja">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bandeja_info" />
        </receiver>

        <!-- Widget "Panel del mes" -->
        <receiver
            android:name=".WidgetPanel"
            android:exported="true"
            android:label="@string/widget_panel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_panel_info" />
        </receiver>

        <!-- Filas de las listas de los widgets -->
        <service
            android:name=".ListaService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Comprobación periódica de bajas y apuntes (notificaciones) -->
        <service
            android:name=".Avisos"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Acciones de widgets y notificaciones (aceptar, descartar, aviso, abrir) -->
        <activity
            android:name=".AccionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
